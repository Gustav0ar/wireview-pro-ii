#!/bin/sh
set -e

if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers /usr/lib/sysusers.d/wireview.conf
fi

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    for device in /sys/class/tty/ttyACM*; do
        [ -e "$device" ] && udevadm trigger --action=add "$device" || true
    done
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl preset wireviewd.socket >/dev/null 2>&1 || true
    systemctl start wireviewd.socket
    systemctl try-restart wireviewd.service >/dev/null 2>&1 || true
fi

exit 0
