# shellcheck shell=bash

post_install() {
  printf '%s\n' 'Enable the socket with: systemctl enable --now wireviewd.socket'
  printf '%s\n' \
    'Add client users to wireview-client, then log in again: usermod --append --groups wireview-client USER'
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl stop wireviewd.service >/dev/null 2>&1 || true
  systemctl try-restart wireviewd.socket >/dev/null 2>&1 || true
}

pre_remove() {
  systemctl disable --now wireviewd.socket >/dev/null 2>&1 || true
  systemctl stop wireviewd.service >/dev/null 2>&1 || true
}

post_remove() {
  for device in /sys/class/tty/ttyACM*; do
    [[ -e "${device}" ]] && udevadm trigger --action=add "${device}" || true
  done
}
